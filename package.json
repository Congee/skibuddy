{
  "name": "skibuddy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run content && vite",
    "build": "bun run content && vite build",
    "preview": "vite preview",
    "content": "bun scripts/build-content.ts",
    "poses": "bun scripts/anatomy/pose-tables.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --ignore-pattern '.claude/**'",
    "test": "vitest run --testNamePattern '^(?!.*legacy: )'",
    "test:legacy": "vitest run --testNamePattern 'legacy: '",
    "test:model": "vitest run --config vitest.model.config.ts",
    "check": "bun run content && bun run typecheck && bun run lint && bun run test",
    "priors": "bun scripts/prior/build.ts",
    "test:solve": "vitest run --config vitest.solve.config.ts",
    "bake:carve": "sh scripts/solve/bake.sh",
    "bake:groomed": "bun scripts/solve/groomed-bake.ts"
  },
  "dependencies": {
    "@effect/atom-solid": "4.0.5",
    "effect": "4.0.5",
    "solid-js": "^1.9.17",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/bun": "^1.4.3",
    "@types/three": "^0.186.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
